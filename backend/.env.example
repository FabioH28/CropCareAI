APP_NAME=CropCare AI API
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_URL=http://127.0.0.1:8080
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","http://127.0.0.1:8080"]
LOG_LEVEL=INFO

DATABASE_URL=mysql+pymysql://root:cropcare_root@127.0.0.1:3308/cropcare_ai
UPLOADS_ROOT=storage
UPLOAD_BUCKET_NAME=diagnosis-images

AUTH_SECRET_KEY=change-me-local-dev-secret-please-replace
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=14

MAX_UPLOAD_SIZE_BYTES=5242880
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]

DEFAULT_MODEL_VERSION=plant-vision-cv-v2-leaf-first
ENABLE_MOCK_INFERENCE=false
ENABLE_DL_CLASSIFIER=true
DL_CHECKPOINT_PATH=ml/plant/artifacts/production/best_model.pt
DL_CONFIDENCE_THRESHOLD=0.65
# TTA passes = 4 is what the published field numbers use; the code default matches.
DL_TTA_PASSES=4
# Per-crop specialists for the cascade (these defaults are also baked into config.py).
DL_APPLE_SPECIALIST_PATH=ml/plant/artifacts/checkpoints/apple_specialist.pt
DL_TOMATO_SPECIALIST_PATH=ml/plant/artifacts/checkpoints/tomato_specialist.pt
DL_GRAPE_SPECIALIST_PATH=ml/plant/artifacts/checkpoints/grape_specialist.pt
DL_CORN_SPECIALIST_PATH=ml/plant/artifacts/checkpoints/corn_specialist.pt
DL_PEPPER_SPECIALIST_PATH=ml/plant/artifacts/checkpoints/pepper_specialist.pt
DL_POTATO_SPECIALIST_PATH=ml/plant/artifacts/checkpoints/potato_specialist.pt
DL_CASCADE_ROUTING_THRESHOLD=0.50
ENABLE_RULES_ADVISORY=true
ENABLE_LLM_ADVISORY=true
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
LLM_TIMEOUT_SECONDS=90
